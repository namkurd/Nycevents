n": "Lower Level", "section": "Ongoing", "organizer_ids": [681]}], "descs": {"92933": "Before New York reconstructs the lives of the inhabitants of New York as it existed on September 12, 1609, inviting visitors to see the city like never before and appreciate how we shape our home.", "197136": "A semi-annual series highlighting films chosen by IFC Center staff members, Fri Jul 10 – Sat Oct 31.", "3286": "Join CRUX, an organization that empowers members of the LGBTQIA+ community through rock climbing and outdoor recreation. This session specifically supports trans, non-binary, and intersex climbers.", "294615": "An exhibition exploring Jim Henson's work for film and television, with objects from The Muppet Show, Sesame Street, Fraggle Rock, The Dark Crystal, Labyrinth, and his experimental film projects.", "294616": "An exhibit drawn from MoMI's permanent collection exploring the production and makeup design of The Exorcist (1973).", "291246": "Exhibition of work by Tatiana Arocha at Sunset Park Library.", "176819": "Celebrates the 50th anniversary of the Dieu Donné Papermill in New York with more than 110 works, including custom sheets and two- and three-dimensional works by artists such as Michele Oka Doner, William Kentridge, Glenn Ligon, and Richard Tuttle. Curated by Susan Gosin with Cynthia Thompson; the 1,000th exhibition presented at The Grolier Club. Exhibitions are open to the public free of charge.", "215137": "Nancy Drosd's painting, Night Swimmer, was selected for acquisition.", "247274": "Led by expert historical interpreters, the walking tour explores restored interiors of buildings chronicling eras of Staten Island’s past, furnished with reproductions and artifacts from the Historic Richmond Town Collection.", "247581": "Streaming: Goethe on Demand celebrates fifty years of punk rebellion. Online, in German with English, Spanish, and French subtitles; free.", "283485": "The Queen's Table online cohort with Lisa Levine, running October 5th, 2026 - January 4th, 2027.", "304897": "3ETV is a bespoke 9-channel TV station curated and produced by Somerset House Studios, developed in collaboration with HEK, M+, Onassis ONX and Pioneer Works. Broadcasting online from 12 October to 18 December 2026 on 3ETV.net.", "244225": "This Gilder Lehrman Institute exhibition uses primary sources to show how the Declaration of Independence has inspired struggles for equality and self-determination worldwide. On view during library open hours from December 2025 through December 2026; the explicit schedule ends December 31.", "22954": "The opening of a new exhibition at Dia Beacon titled Agnes Martin: Painting is not making paintings. The show presents a selection of the artist's minimalist and abstract works.", "159039": "An exhibit exploring the impact of the American Revolution on Suffolk County residents through historical artifacts, highlighting the challenges faced during British occupation.", "159100": "Featured seasonal event at Empire Stores, running Nov 20 - Mar 1.", "246952": "Come meet cute IRL and capture the love: @meetcutesnyc's new photo booth at Chelsea Market lets you snap a moment with someone special and take home a memory worth keeping.", "314985": "Santa's Winter Wonderland at Watermark, running November 13 - December 27. Categories: Holiday, Eat & Drink, Family Friendly.", "253260": "Learn the art and fun of classic social English dancing from the 18th century. No experience is necessary; participants should bring their dancing shoes.", "305145": "The City's most famous ice-skating rink is a holiday must-visit during fall and winter.", "257509": "Creativity Lab installation exploring the art of the book.", "293366": "Live cover band set; no cover charge."}}